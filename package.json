{
  "name": "trustpkg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "initialize": "bash scripts/init.sh",
    "typecheck": "npx tsc --noEmit --strict",
    "themes:generate": "bash scripts/generateThemes.sh",
    "api:generate": "set -a && . ./.env && set +a && curl --fail --show-error --location \"$NEXT_PUBLIC_BE_URL/api/openapi.json\" -o /tmp/trustpkg-openapi.json && pnpm exec openapi-zod-client /tmp/trustpkg-openapi.json -o src/api/api.ts --export-schemas --export-types --with-docs && pnpm exec openapi-typescript /tmp/trustpkg-openapi.json -o src/api/api.types.ts && tsx scripts/generateApiParameters.ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.37.2",
    "@tanstack/react-query": "5.102.8",
    "@zodios/core": "^10.9.6",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "16.2.12",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "1.18.3",
    "prettier": "^3.9.6",
    "sass": "1.99.0",
    "sass-embedded": "1.99.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
