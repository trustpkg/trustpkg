{
  "name": "trustpkg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "IS_PRODUCTION_BUILD=true && pnpm build",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint",
    "initialize": "bash scripts/init.sh",
    "typecheck": "npx tsc --noEmit --strict",
    "themes:generate": "bash scripts/generateThemes.sh",
    "api:generate": "set -a && . ./.env && set +a && openapi-ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.37.2",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@svgr/webpack": "8.1.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.6",
    "sass": "1.99.0",
    "sass-embedded": "1.99.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
